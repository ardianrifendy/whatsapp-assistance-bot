# --- App ---
NODE_ENV=production
TZ=Asia/Jakarta
LOG_LEVEL=info
HEALTHCHECK_PORT=3000

# --- Database (Supabase Postgres) ---
# Use the Supabase "connection pooling" string for the running app,
# and the direct connection string only for running migrations.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
DATABASE_SSL=true

# --- Owner bootstrap ---
# One or more normalized WhatsApp numbers (digits only, no +, no @c.us),
# comma-separated for multiple Owners, e.g. 628111111111,628222222222
OWNER_WHATSAPP_NUMBER=628xxxxxxxxxx

# --- WhatsApp session / assets ---
WHATSAPP_SESSION_PATH=/app/.wwebjs_auth
HELP_ASSETS_PATH=/app/assets/help

# --- Business rules ---
SESSION_EXPIRY_MINUTES=2
MAX_BATCH_ITEMS=50
ENABLE_CLEAR_ALL=false
